# Supplemental prefixes, not a shell parser or sandbox.
prefix_rule(pattern = ["rm"], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["rmdir"], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["rd"], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["del"], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["erase"], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["unlink"], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["Remove-Item"], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["git","reset","--hard"], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["git","clean"], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["git","rm"], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["git","push",["--force","-f","--force-with-lease","--force-if-includes"]], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["git","config","--unset","core.hooksPath"], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["node",["-e","--eval","-p","--print"]], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["python",["-c","-"]], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["python3",["-c","-"]], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["powershell",["-Command","-EncodedCommand"]], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["pwsh",["-Command","-EncodedCommand"]], decision = "forbidden", justification = "No deletion, force push, hook bypass, or hidden interpreter execution.")
prefix_rule(pattern = ["sudo"], decision = "prompt", justification = "Explicit human confirmation required.")
prefix_rule(pattern = ["runas"], decision = "prompt", justification = "Explicit human confirmation required.")
prefix_rule(pattern = ["chmod"], decision = "prompt", justification = "Explicit human confirmation required.")
prefix_rule(pattern = ["chown"], decision = "prompt", justification = "Explicit human confirmation required.")
prefix_rule(pattern = ["icacls"], decision = "prompt", justification = "Explicit human confirmation required.")
prefix_rule(pattern = ["Set-Acl"], decision = "prompt", justification = "Explicit human confirmation required.")
prefix_rule(pattern = ["psql"], decision = "prompt", justification = "Explicit human confirmation required.")
prefix_rule(pattern = ["mysql"], decision = "prompt", justification = "Explicit human confirmation required.")
prefix_rule(pattern = ["sqlite3"], decision = "prompt", justification = "Explicit human confirmation required.")
prefix_rule(pattern = ["mongosh"], decision = "prompt", justification = "Explicit human confirmation required.")
prefix_rule(pattern = ["sqlcmd"], decision = "prompt", justification = "Explicit human confirmation required.")
prefix_rule(pattern = ["git", "commit"], decision = "prompt", justification = "An approved plan does not authorize creating history or publishing.")
prefix_rule(pattern = ["git", "push"], decision = "prompt", justification = "An approved plan does not authorize creating history or publishing.")
prefix_rule(pattern = ["git", "merge"], decision = "prompt", justification = "An approved plan does not authorize creating history or publishing.")
